require 'fileutils'
require 'pathname'
source 'https://cdn.cocoapods.org/'
platform :ios, '16.0'
install! 'cocoapods', :disable_input_output_paths => true, :warn_for_unused_master_specs_repo => false
use_frameworks! :linkage => :static
JOBS_TEMPLATE_ROOT = ENV.fetch('JOBS_SWIFT_TEMPLATE', File.expand_path('../../../../JobsBaseConfig/JobsBaseConfig@JobsSwiftBaseConfigDemo', __dir__))
raise '请设置 JOBS_SWIFT_TEMPLATE 指向本人 Swift 基础工程' unless File.file?(File.join(JOBS_TEMPLATE_ROOT, 'Podfile.deps'))
JOBS_PODS_PATH = Pathname.new(File.join(JOBS_TEMPLATE_ROOT, 'JobsByPods')).relative_path_from(Pathname.new(__dir__)).to_s
target 'JobsIM' do
  eval(File.read(File.join(__dir__, 'Podfile.deps')), binding, 'Podfile.deps')
  target 'JobsIMTests' do
    inherit! :search_paths
  end
end
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['SWIFT_VERSION'] = target.name.start_with?('JobsIM', 'GRDB') ? '6.0' : '5.0'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end
  project = installer.pods_project
  root_uuid = project.root_object.uuid
  ['Podfile', 'Podfile.deps'].each do |name|
    path = "../#{name}"
    refs = project.main_group.files.select { |f| f.path == path }
    raise "重复的#{name}引用" if refs.length > 1
    ref = refs.first || project.main_group.new_file(path)
    ref.explicit_file_type = 'text.script.ruby'
  end
  project.save
  check = Xcodeproj::Project.open(project.path)
  raise 'Pods根对象异常' unless check.root_object.isa == 'PBXProject' && check.root_object.uuid == root_uuid
end
