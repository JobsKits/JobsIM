```go
1	package jobsim
2	
3	import (
4		"context"
5		"fmt"
6		"os/exec"
7		"path/filepath"
8		"runtime"
9		"strconv"
10		"strings"
11	)
12	
13	func deploymentRequireSpace(ctx context.Context, path string, additional int64) error {
14		var raw []byte
15		var err error
16		var free uint64
17		if runtime.GOOS == "windows" {
18			literal := strings.ReplaceAll(filepath.Clean(path), "'", "''")
19			raw, err = exec.CommandContext(ctx, "powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "[System.IO.DriveInfo]::new([System.IO.Path]::GetPathRoot('"+literal+"')).AvailableFreeSpace").Output()
20			if err == nil {
21				free, err = strconv.ParseUint(strings.TrimSpace(string(raw)), 10, 64)
22			}
23		} else {
24			// Deployment shells may shadow df with a user command of the same name.
25			raw, err = exec.CommandContext(ctx, "/bin/df", "-Pk", path).Output()
26			if err == nil {
27				lines := strings.Split(strings.TrimSpace(string(raw)), "\n")
28				parts := strings.Fields(lines[len(lines)-1])
29				if len(parts) < 4 {
30					err = fmt.Errorf("unknown disk capacity response")
31				} else {
32					free, err = strconv.ParseUint(parts[3], 10, 64)
33					free *= 1024
34				}
35			}
36		}
37		if err != nil {
38			return fmt.Errorf("cannot verify the 4 GiB restore disk reserve")
39		}
40		if additional < 0 || free < 4<<30 || uint64(additional) > free-(4<<30) {
41			return fmt.Errorf("restore requires an untouched 4 GiB disk reserve")
42		}
43		return nil
44	}
