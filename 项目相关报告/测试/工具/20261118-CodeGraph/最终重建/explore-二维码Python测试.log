26	def pty_run(script, arguments, rows, columns, environment, menu=False):
27	    """保留实际PTY字节；菜单用本轮短sleep代替业务，只验证扫码停留和回车。"""
28	    pid, fd = pty.fork()
29	    if pid == 0:
30	        os.execve("/bin/zsh", ["/bin/zsh", str(script)] + arguments, environment)
31	    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, columns, 0, 0))
32	    result = b""
33	    deadline = time.monotonic() + 30
34	    ready = None
35	    entered = False
36	    menu_seen = False
37	    while time.monotonic() < deadline:
38	        readable, _, _ = select.select([fd], [], [], .1)
39	        if readable:
40	            try:
41	                data = os.read(fd, 65536)
42	            except OSError:
43	                break
44	            if not data:
45	                break
46	            result += data
47	            if b"\x1b[6n" in data:
48	                os.write(fd, b"\x1b[30;1R")
49	        if menu and b"QR-READY" in result:
50	            if ready is None:
51	                ready = time.monotonic()
52	            if not entered and time.monotonic() - ready > .6:
53	                assert "打开网页 >" not in result.decode("utf-8", "replace"), "未回车便弹出fzf遮住二维码"
54	                os.write(fd, b"\r")
55	                entered = True
56	            if entered and "打开网页 >" in result.decode("utf-8", "replace") and not menu_seen:
57	                menu_seen = True
58	                os.write(fd, b"\x1b")
59	    else:
60	        os.kill(pid, 15)
61	        raise RuntimeError("二维码PTY等待超时")
62	    _, status = os.waitpid(pid, 0)
63	    os.close(fd)
64	    if os.waitstatus_to_exitcode(status) != 0:
65	        failure = script.parent / "last-failed-PTY.log"
66	        failure.write_bytes(result)
67	        raise RuntimeError(f"PTY退出{os.waitstatus_to_exitcode(status)}；原件见{failure}")
68	    if menu:
69	        assert entered and menu_seen
70	    return result
