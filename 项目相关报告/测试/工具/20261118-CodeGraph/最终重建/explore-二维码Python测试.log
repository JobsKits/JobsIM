73	def decode_png(path):
74	    source = """ObjC.import('AppKit');ObjC.import('CoreImage');function run(argv){var d=$.CIDetector.detectorOfTypeContextOptions($.CIDetectorTypeQRCode,$.CIContext.contextWithOptions($.NSDictionary.dictionary),$({CIDetectorAccuracy:'CIDetectorAccuracyHigh'}));var i=$.CIImage.imageWithContentsOfURL($.NSURL.fileURLWithPath(argv[0]));var a=d.featuresInImage(i);if(Number(a.count)!==1)throw Error('cannot decode '+argv[0]);return ObjC.unwrap(a.objectAtIndex(0).messageString);}"""
75	    return subprocess.check_output(["/usr/bin/osascript", "-l", "JavaScript", "-e", source, str(path)], text=True).strip()
