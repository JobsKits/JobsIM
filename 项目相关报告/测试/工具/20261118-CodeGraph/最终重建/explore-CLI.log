479	func (m *authManager) rotate(original authPair) (authPair, error) {
480		m.mu.Lock()
481		defer m.mu.Unlock()
482		if m.state.Status != "active" || m.pair.FamilyID != original.FamilyID || m.pair.DeviceID != original.DeviceID || m.pair.User.ID != original.User.ID {
