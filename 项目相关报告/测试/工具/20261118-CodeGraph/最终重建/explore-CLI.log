565		finish := func(e error) error {
566			if e != nil {
567				var api *apiFailure
568				if c.store != nil && errors.As(e, &api) && (api.Status == 401 || api.Code == "RESTORE_EPOCH_CHANGED" || api.Code == "DEPLOYMENT_CHANGED") {
569					retireErr := c.store.retireSyncIdentity("SYNC_REAUTH_REQUIRED")
570					c.lookup = nil
571					c.token = ""
572					if retireErr != nil {
573						return fmt.Errorf("%w; retiring local identity failed: %v", e, retireErr)
574					}
575				}
576				return e
577			}
578			if observe {
579				if e = c.observeMessageGlobals(method, path, body, observed); e != nil {
580					return e
581				}
582				if out != nil && len(observed) != 0 {
583					return syncDecode(observed, out)
584				}
585			}
586			return nil
587		}
588		if c.auth == nil {
589			err := c.callWithToken(method, path, body, target, c.token)
590			if guardErr := c.syncHTTPAfter(stamp); guardErr != nil {
591				return guardErr
592			}
593			return finish(err)
594		}
595		original, err := c.auth.snapshot()
596		if err != nil {
597			return err
598		}
599		var frozen any
600		if body != nil {
601			raw, err := json.Marshal(body)
602			if err != nil {
603				return err
604			}
605			frozen = json.RawMessage(raw)
606		}
607		err = c.callWithToken(method, path, frozen, target, original.Token)
608		if guardErr := c.syncHTTPAfter(stamp); guardErr != nil {
609			return guardErr
610		}
611		if !c.auth.owns(original) {
612			return fmt.Errorf("late response belongs to a stopped authentication context")
613		}
614		var api *apiFailure
