210	func (m *authManager) validPair(pair authPair) bool {
211		if pair.Token == "" || pair.User.ID == "" || pair.User.Username != m.username || pair.DeviceID == "" || pair.RestoreEpoch != m.c.epoch {
212			return false
213		}
214		if !m.refresh {
215			return pair.RefreshToken == ""
216		}
217		if pair.RefreshToken == "" || pair.FamilyID == "" || !decimal.MatchString(pair.RefreshGeneration) || pair.SourceContextID != "personal" {
218			return false
219		}
220		for _, value := range []string{pair.AccessExpiresAt, pair.IdleExpiresAt, pair.AbsoluteExpiresAt} {
221			deadline, err := time.Parse(time.RFC3339Nano, value)
222			if err != nil || deadline.Location() != time.UTC {
223				return false
224			}
225		}
226		return true
227	}
