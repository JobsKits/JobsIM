372	func (m *authManager) prepareInitial(mode string) (authIntent, error) {
373		if len(m.state.Pending) > 0 && mode != "reauthenticate" {
374			return m.state.Pending[len(m.state.Pending)-1], nil
375		}
376		intent := authIntent{Mode: mode, Username: m.username, RequestID: id(), DeviceName: "JobsIM CLI"}
377		if len(m.state.Pending) > 0 {
378			last := m.state.Pending[len(m.state.Pending)-1]
379			if last.Mode == "register" && !last.DeliveryExpired && m.state.FamilyID == "" {
380				return intent, fmt.Errorf("unknown registration must continue its original ID until the server confirms delivery expiry; local elapsed time proves nothing")
381			}
382			var keys []string
383			for _, previous := range m.state.Pending {
384				for _, key := range previous.PreviousRequestIDs {
385					keys = appendAuthKey(keys, key)
386				}
387				keys = appendAuthKey(keys, previous.PreviousRequestID)
388				keys = appendAuthKey(keys, previous.RequestID)
389			}
390			if len(keys) > 64 || len(keys) > 1 && !m.chain {
391				return intent, fmt.Errorf("server does not prove this complete authentication retirement chain; continue the original intent")
392			}
393			intent.Mode, intent.PreviousRequestIDs = "reauthenticate", keys
394			intent.PreviousRequestID = keys[len(keys)-1]
395		}
396		if m.state.FamilyID != "" && mode != "register" {
397			intent.Mode, intent.PreviousFamilyID = "reauthenticate", m.state.FamilyID
398		}
399		if intent.Mode == "reauthenticate" && intent.PreviousFamilyID == "" && len(intent.PreviousRequestIDs) == 0 {
400			return intent, fmt.Errorf("no original family or unknown initial intent is recorded; use login")
401		}
402		m.state.Pending = append(m.state.Pending, intent)
403		m.state.Status = "initial_pending"
404		if err := m.persist(); err != nil {
405			return intent, err
406		}
407		return intent, nil
408	}
