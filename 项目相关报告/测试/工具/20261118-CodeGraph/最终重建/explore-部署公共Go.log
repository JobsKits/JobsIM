92	// Only owned ordinary output files may be atomically replaced.
93	func writeOutput(dir, name string, data []byte) error {
94		destination := filepath.Join(dir, name)
95		if st, err := os.Lstat(destination); err == nil && !st.Mode().IsRegular() {
96			return fmt.Errorf("拒绝替换非普通输出文件")
97		} else if err != nil && !os.IsNotExist(err) {
98			return err
99		}
100		tmp, err := os.CreateTemp(dir, ".qr-*")
101		if err != nil {
102			return err
103		}
104		defer os.Remove(tmp.Name())
105		if _, err = tmp.Write(data); err != nil {
106			tmp.Close()
107			return err
108		}
109		if err = tmp.Close(); err != nil {
110			return err
111		}
112		return os.Rename(tmp.Name(), destination)
113	}
