40	// Reject credential-bearing or wildcard addresses before displaying or encoding anything.
41	func parseCard(raw string) (card, error) {
42		label, address, ok := strings.Cut(raw, "|")
43		if !ok || strings.TrimSpace(label) == "" || strings.ContainsAny(raw, "\r\n\t\x1b") {
44			return card{}, fmt.Errorf("入口必须为 标题|完整HTTP地址，不能含控制字符")
45		}
46		u, err := url.Parse(address)
47		if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Hostname() == "" || u.Opaque != "" {
48			return card{}, fmt.Errorf("入口必须为完整HTTP或HTTPS地址")
49		}
50		if u.User != nil {
51			return card{}, fmt.Errorf("入口不能含账户凭据")
52		}
53		query, err := url.ParseQuery(u.RawQuery)
54		if err != nil {
55			return card{}, fmt.Errorf("入口查询参数无效")
56		}
57		fragment, _ := url.ParseQuery(u.Fragment)
58		for _, fields := range []url.Values{query, fragment} {
59			for key := range fields {
60				switch strings.ToLower(key) {
61				case "token", "access_token", "refresh_token", "password", "passwd", "secret", "api_key", "apikey", "authorization", "credential", "session", "sessionid", "code", "signature", "sig":
62					return card{}, fmt.Errorf("入口不能含认证或签名参数")
63				}
64			}
65		}
66		if u.Hostname() == "0.0.0.0" || u.Hostname() == "::" {
67			return card{}, fmt.Errorf("监听通配地址不能作为访问入口")
68		}
69		qr, err := qrcode.New(address, qrcode.Medium)
70		if err != nil {
71			return card{}, fmt.Errorf("二维码内容过长或无法编码")
72		}
73		return card{Label: label, URL: address, Bitmap: qr.Bitmap()}, nil
74	}
