162	func run(args []string, out io.Writer) error {
163		fs := flag.NewFlagSet("deployqr", flag.ContinueOnError)
164		fs.SetOutput(io.Discard)
165		var values entries
166		dir := fs.String("output-dir", "", "本次运行独占的输出目录")
167		title := fs.String("title", "部署访问入口", "页面标题")
168		width := fs.Int("terminal-width", 0, "终端列数；0仅生成文件")
169		height := fs.Int("terminal-height", 0, "终端行数；0不限制高度")
170		ansi := fs.Bool("ansi", false, "终端允许黑白ANSI二维码")
171		expire := fs.Bool("expire", false, "将本次页面标记失效")
172		fs.Var(&values, "entry", "入口标题|完整URL，可重复")
173		if err := fs.Parse(args); err != nil {
174			return fmt.Errorf("二维码参数无效")
175		}
176		if *dir == "" || fs.NArg() != 0 || *width < 0 || *height < 0 || (!*expire && len(values) == 0) {
177			return fmt.Errorf("需要 --output-dir 和至少一个 --entry")
178		}
179		var cards []card
180		for _, raw := range values {
181			c, err := parseCard(raw)
182			if err != nil {
183				return err
184			}
185			cards = append(cards, c)
186		}
187		// Validate before writing; do not follow a symlink output directory.
188		if st, err := os.Lstat(*dir); err == nil && (!st.IsDir() || st.Mode()&os.ModeSymlink != 0) {
189			return fmt.Errorf("二维码目录不能为符号链接或文件")
190		} else if err != nil && !os.IsNotExist(err) {
191			return err
192		}
193		if err := os.MkdirAll(*dir, 0700); err != nil {
194			return err
195		}
196		for i := range cards {
197			cards[i].SVG = fmt.Sprintf("%02d.svg", i+1)
198			cards[i].Image = template.HTML(svgFor(cards[i]))
199			if err := writeOutput(*dir, cards[i].SVG, []byte(cards[i].Image)); err != nil {
200				return err
201			}
202			n := len(cards[i].Bitmap) * 8
203			img := image.NewGray(image.Rect(0, 0, n, n))
204			for y := 0; y < n; y++ {
205				for x := 0; x < n; x++ {
206					shade := color.Gray{Y: 255}
207					if cards[i].Bitmap[y/8][x/8] {
208						shade.Y = 0
209					}
210					img.SetGray(x, y, shade)
211				}
212			}
213			var raster bytes.Buffer
214			if err := png.Encode(&raster, img); err != nil {
215				return err
216			}
217			if err := writeOutput(*dir, fmt.Sprintf("%02d.png", i+1), raster.Bytes()); err != nil {
218				return err
219			}
220		}
221		t, err := template.New("page").Parse(pageHTML)
222		if err != nil {
223			return err
224		}
225		var b bytes.Buffer
226		if err := t.Execute(&b, page{Title: *title, Generated: time.Now().Format(time.RFC3339), Cards: cards, Expired: *expire}); err != nil {
227			return err
228		}
229		if err := writeOutput(*dir, "index.html", b.Bytes()); err != nil {
230			return err
231		}
232		if !*expire {
233			// Keep the primary (first) address visible above the prompt when multiple cards scroll.
234			for i := len(cards) - 1; i >= 0; i-- {
235				terminalCard(out, cards[i], *width, *height, *ansi)
236			}
237			abs, _ := filepath.Abs(filepath.Join(*dir, "index.html"))
238			fmt.Fprintf(out, "\n本地二维码页面（浏览器打开）：\n%s\n", abs)
239		}
240		return nil
241	}
242	func main() {
243		if err := run(os.Args[1:], os.Stdout); err != nil {
244			fmt.Fprintln(os.Stderr, "二维码未生成：", err)
245			os.Exit(1)
246		}
247	}
