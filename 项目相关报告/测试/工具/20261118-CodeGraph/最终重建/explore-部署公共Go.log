115	// Background-filled two-column modules stay square without depending on block-glyph metrics.
116	func terminalCard(out io.Writer, c card, width, height int, ansi bool) {
117		fmt.Fprintf(out, "\n%s\n%s\n", c.Label, c.URL)
118		_, noColor := os.LookupEnv("NO_COLOR")
119		ansi = ansi && !noColor
120		columns, rows := len(c.Bitmap)+2, (len(c.Bitmap)+1)/2+6
121		if ansi {
122			columns, rows = 2*len(c.Bitmap)+2, len(c.Bitmap)+6
123		}
124		if width < columns || (height > 0 && height < rows) {
125			fmt.Fprintf(out, "终端二维码需要至少%d列×%d行；请使用本轮本地二维码图片或页面。\n", columns, rows)
126			return
127		}
128		if ansi {
129			fmt.Fprintln(out, "终端二维码（黑白方格）：")
130			for _, row := range c.Bitmap {
131				for _, dark := range row {
132					if dark {
133						fmt.Fprint(out, "\x1b[40m  ")
134					} else {
135						fmt.Fprint(out, "\x1b[47m  ")
136					}
137				}
138				fmt.Fprintln(out, "\x1b[0m")
139			}
140			return
141		}
142		fmt.Fprintln(out, "终端二维码（字符显示；颜色由终端主题决定）：")
143		for y := 0; y < len(c.Bitmap); y += 2 {
144			for x := range c.Bitmap[y] {
145				top := c.Bitmap[y][x]
146				bottom := y+1 < len(c.Bitmap) && c.Bitmap[y+1][x]
147				switch {
148				case top && bottom:
149					fmt.Fprint(out, "█")
150				case top:
151					fmt.Fprint(out, "▀")
152				case bottom:
153					fmt.Fprint(out, "▄")
154				default:
155					fmt.Fprint(out, " ")
156				}
157			}
158			fmt.Fprintln(out)
159		}
160	}
